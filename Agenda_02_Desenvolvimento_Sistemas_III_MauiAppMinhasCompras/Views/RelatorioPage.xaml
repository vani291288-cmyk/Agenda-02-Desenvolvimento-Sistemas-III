<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.RelatorioPage"
             Title="Relatório por Categoria">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Relatório de Compras por Categoria"
                   FontSize="24"
                   FontAttributes="Bold" />

            <Label Text="Total gasto em cada categoria"
                   FontSize="17" />

            <CollectionView x:Name="RelatorioCollection">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="1"
                                Padding="14"
                                Margin="0,5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Categoria}"
                                       FontAttributes="Bold"
                                       FontSize="18" />
                                <Label Grid.Column="1"
                                       Text="{Binding Total, StringFormat='R$ {0:F2}'}"
                                       FontSize="18" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="TotalGeralLabel"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />

            <Button Text="Voltar"
                    Clicked="OnVoltarClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
